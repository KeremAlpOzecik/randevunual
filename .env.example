# Firebase (Firebase Console > Project settings > Your apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Logo için (Blaze + Storage) — şimdilik boş bırakılabilir
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Canlı site adresi (Vercel / kendi domain) — localhost linklerini önler
NEXT_PUBLIC_SITE_URL=https://randevunual.com.tr
